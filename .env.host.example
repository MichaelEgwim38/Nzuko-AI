# Copy this file to .env.host on the hosted server.
# Do not commit or share .env.host.

PORT=5177
PUBLIC_APP_HOST=your-nzuko-ai-domain.example
PUBLIC_APP_URL=https://your-nzuko-ai-domain.example

APPROVED_GROUP_NAME=Umuokoroji Family WhatsApp Group
APPROVED_GROUP_ID=
CONSENT_CONFIRMED=true
RETENTION_DAYS=14

CONNECTOR_MODE=waha
WAHA_BASE_URL=http://waha:3000
WAHA_PUBLIC_URL=
WAHA_SESSION=default
WAHA_API_KEY=change-this-waha-api-key
WAHA_IMAGE=devlikeapro/waha:latest
WHATSAPP_DEFAULT_ENGINE=NOWEB
WHATSAPP_HOOK_EVENTS=message,message.any
WAHA_MEDIA_STORAGE=LOCAL
WAHA_CLIENT_DEVICE_NAME=Nzuko AI
WAHA_CLIENT_BROWSER_NAME=Chrome

OPENAI_API_KEY=sk-proj-replace-this
ADMIN_PASSCODE=change-this-admin-passcode
ADMIN_SESSION_MAX_AGE_SECONDS=604800

TRANSCRIBE_MODEL=gpt-4o-transcribe
TRANSCRIBE_LANGUAGE=auto
TRANSLATE_MODEL=gpt-4.1-mini
